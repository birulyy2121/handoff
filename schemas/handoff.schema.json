{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoffState",
  "description": "Universal schema for cross-agent state handoffs and flight recording",
  "type": "object",
  "required": [
    "version",
    "timestamp",
    "origin_agent",
    "active_goal",
    "invariants",
    "touched_files",
    "next_steps"
  ],
  "properties": {
    "version": {
      "type": "string",
      "default": "1.0.0"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "origin_agent": {
      "type": "string",
      "enum": [
        "claude-code",
        "antigravity",
        "cursor",
        "codex",
        "openhands",
        "roo-code",
        "custom"
      ]
    },
    "checkpoint_ref": {
      "type": "string"
    },
    "active_goal": {
      "type": "string"
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
